# Atlas: preencha MONGODB_URI (no portfólio, vem de PoVs/.env.shared via _shared/sync_env.py).
# Vazio (default) ou FROTA_MONGO=local: usa o MongoDB do docker compose.
MONGODB_URI=
MONGODB_URI_LOCAL=mongodb://localhost:27027/?replicaSet=rs0
FROTA_MONGO=auto
MONGODB_DB=frota_eta
MONGODB_TEST_DB=frota_eta_test
MONGODB_FIXTURES_DB=frota_eta_fixtures

# Portas desta POV (reservar em PoVs/PORTS.md ao integrar no portfólio)
BACKEND_PORT=8410
FRONTEND_PORT=5410

# Valores iniciais da collection `config` (documento "ativa"); depois disso vale o banco.
FROTA_TIMEZONE=America/Sao_Paulo
FROTA_JANELA_DIAS=180
FROTA_K_REPROCESSAMENTO=3
FROTA_MIN_AMOSTRAS=5
FROTA_REGRA_NOITE=dia_civil
FROTA_MODO_LIMPEZA_CAMADA2=merge_runid
FROTA_TTL_RAW_DIAS=200
FROTA_TTL_BUCKET_DIAS=190

# Gerador
SEED=42
