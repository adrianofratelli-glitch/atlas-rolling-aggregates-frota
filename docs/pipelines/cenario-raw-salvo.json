{
  "descricao": "Cenário sob demanda salvo: o $merge em consultas_salvas é o último estágio (TTL apaga quando passa do expiraEm).",
  "colecao": "trecho_observacoes",
  "dataRef": "2026-10-22",
  "estagios": [
    {
      "comentario": "Pega as observações da rota e do tipo de veículo no período pedido (o fim fica de fora).",
      "estagio": {
        "$match": {
          "origem": "BASE-001",
          "destino": "POSTO-11",
          "tipoVeiculo": "CARRETA",
          "observadoEm": {
            "$gte": {
              "$date": "2026-04-25T03:00:00Z"
            },
            "$lt": {
              "$date": "2026-10-22T03:00:00Z"
            }
          }
        }
      }
    },
    {
      "comentario": "Descobre o dia da semana (1 = segunda … 7 = domingo) e a hora, no horário de São Paulo.",
      "estagio": {
        "$set": {
          "dow": {
            "$isoDayOfWeek": {
              "date": "$observadoEm",
              "timezone": "America/Sao_Paulo"
            }
          },
          "hora": {
            "$hour": {
              "date": "$observadoEm",
              "timezone": "America/Sao_Paulo"
            }
          }
        }
      }
    },
    {
      "comentario": "Fica só com os dias da semana e as horas escolhidos.",
      "estagio": {
        "$match": {
          "dow": {
            "$in": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "hora": {
            "$in": [
              6,
              7,
              8,
              9,
              10,
              11
            ]
          }
        }
      }
    },
    {
      "comentario": "Junta tudo num único resultado com contagem e somas.",
      "estagio": {
        "$group": {
          "_id": null,
          "n": {
            "$sum": 1
          },
          "somaMin": {
            "$sum": "$tempoMin"
          },
          "somaQuadMin": {
            "$sum": {
              "$multiply": [
                "$tempoMin",
                "$tempoMin"
              ]
            }
          },
          "somaKm": {
            "$sum": "$distanciaKm"
          }
        }
      }
    },
    {
      "comentario": "Arredonda as somas, identifica a consulta pela chave do filtro e marca até quando ela vale.",
      "estagio": {
        "$project": {
          "_id": {
            "$literal": "<chave do filtro>"
          },
          "n": 1,
          "somaMin": {
            "$round": [
              "$somaMin",
              6
            ]
          },
          "somaQuadMin": {
            "$round": [
              "$somaQuadMin",
              6
            ]
          },
          "somaKm": {
            "$round": [
              "$somaKm",
              6
            ]
          },
          "filtro": {
            "$literal": {
              "origem": "BASE-001",
              "destino": "POSTO-11",
              "tipoVeiculo": "CARRETA",
              "dias": [
                1,
                2,
                3,
                4,
                5
              ],
              "horas": [
                6,
                7,
                8,
                9,
                10,
                11
              ],
              "periodo": {
                "tipo": "padrao"
              }
            }
          },
          "periodo": {
            "$literal": "relativo"
          },
          "criadoEm": "$$NOW",
          "expiraEm": {
            "$literal": {
              "$date": "2026-10-23T06:10:00Z"
            }
          }
        }
      }
    },
    {
      "comentario": "Grava o resultado em consultas_salvas: a mesma consulta substitui a anterior; o índice TTL apaga o documento quando passa do expiraEm.",
      "estagio": {
        "$merge": {
          "into": "consultas_salvas",
          "on": "_id",
          "whenMatched": "replace",
          "whenNotMatched": "insert"
        }
      }
    }
  ],
  "pipeline": [
    {
      "$match": {
        "origem": "BASE-001",
        "destino": "POSTO-11",
        "tipoVeiculo": "CARRETA",
