{
  "descricao": "Mesma resposta do fallback calculada na raw (regraNoite dia_civil).",
  "colecao": "trecho_observacoes",
  "asOf": "2026-10-16",
  "estagios": [
    {
      "comentario": "Todas as observações do trecho/veículo na janela [início, fim). Usa o índice { origem, destino, tipoVeiculo, observadoEm }.",
      "estagio": {
        "$match": {
          "origem": "BASE-001",
          "destino": "POSTO-0042",
          "tipoVeiculo": "BITREM",
          "observadoEm": {
            "$gte": {
              "$date": "2026-04-19T03:00:00Z"
            },
            "$lt": {
              "$date": "2026-10-16T03:00:00Z"
            }
          }
        }
      }
    },
    {
      "comentario": "Hora e dia da semana locais de cada observação, no momento da consulta.",
      "estagio": {
        "$set": {
          "hora": {
            "$hour": {
              "date": "$observadoEm",
              "timezone": "America/Sao_Paulo"
            }
          },
          "dowCivil": {
            "$dayOfWeek": {
              "date": "$observadoEm",
              "timezone": "America/Sao_Paulo"
            }
          }
        }
      }
    },
    {
      "comentario": "Mesmas expressões de turno/dow da camada 2.",
      "estagio": {
        "$set": {
          "turno": {
            "$switch": {
              "branches": [
                {
                  "case": {
                    "$and": [
                      {
                        "$gte": [
                          "$hora",
                          6
                        ]
                      },
                      {
                        "$lt": [
                          "$hora",
                          12
                        ]
                      }
                    ]
                  },
                  "then": "M"
                },
                {
                  "case": {
                    "$and": [
                      {
                        "$gte": [
                          "$hora",
                          12
                        ]
                      },
                      {
                        "$lt": [
                          "$hora",
                          18
                        ]
                      }
                    ]
                  },
                  "then": "T"
                }
              ],
              "default": "N"
            }
          },
          "dow": "$dowCivil"
        }
      }
    },
    {
      "comentario": "Mesmo grão do agregado: dow × turno.",
      "estagio": {
        "$group": {
          "_id": {
            "dow": "$dow",
            "turno": "$turno"
          },
          "somaMin": {
            "$sum": "$tempoMin"
          },
          "somaKm": {
            "$sum": "$distanciaKm"
          },
          "n": {
            "$sum": 1
          }
        }
      }
    },
    {
      "comentario": "Mesmo formato dos documentos de trecho_media_historica.",
      "estagio": {
        "$project": {
          "_id": 0,
          "dow": "$_id.dow",
          "turno": "$_id.turno",
          "somaMin": 1,
          "somaKm": 1,
          "n": 1
        }
      }
    }
  ],
  "pipeline": [
    {
      "$match": {
        "origem": "BASE-001",
        "destino": "POSTO-0042",
        "tipoVeiculo": "BITREM",
        "observadoEm": {
          "$gte": {
            "$date": "2026-04-19T03:00:00Z"
          },
          "$lt": {
            "$date": "2026-10-16T03:00:00Z"
          }
        }
      }
    },
    {
      "$set": {
        "hora": {
          "$hour": {
            "date": "$observadoEm",
            "timezone": "America/Sao_Paulo"
          }
        },
        "dowCivil": {
          "$dayOfWeek": {
            "date": "$observadoEm",
            "timezone": "America/Sao_Paulo"
          }
        }
      }
    },
    {
      "$set": {
        "turno": {
          "$switch": {
            "branches": [
              {
                "case": {
                  "$and": [
                    {
                      "$gte": [
                        "$hora",
                        6
                      ]
                    },
                    {
                      "$lt": [
                        "$hora",
                        12
                      ]
                    }
                  ]
                },
                "then": "M"
              },
              {
                "case": {
                  "$and": [
                    {
                      "$gte": [
                        "$hora",
                        12
                      ]
                    },
                    {
                      "$lt": [
                        "$hora",
                        18
                      ]
                    }
                  ]
                },
                "then": "T"
              }
            ],
            "default": "N"
          }
        },
        "dow": "$dowCivil"
      }
    },
    {
      "$group": {
        "_id": {
          "dow": "$dow",
          "turno": "$turno"
        },
        "somaMin": {
          "$sum": "$tempoMin"
        },
        "somaKm": {
          "$sum": "$distanciaKm"
        },
        "n": {
          "$sum": 1
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "dow": "$_id.dow",
        "turno": "$_id.turno",
        "somaMin": 1,
        "somaKm": 1,
        "n": 1
      }
    }
  ]
}