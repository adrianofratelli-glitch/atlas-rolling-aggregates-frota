{
  "descricao": "Camada 2 com asOf 2026-10-16, janela [2026-04-19T03:00Z, 2026-10-16T03:00Z), limpeza merge_runid.",
  "colecao": "trecho_bucket_diario",
  "asOf": "2026-10-16",
  "estagios": [
    {
      "comentario": "Recorte da janela móvel sobre o dia local do bucket: [início, fim) semiaberto, sem $lte. Usa o índice { dataLocal: 1 }. O dia de hoje nunca entra porque fim = 00:00 local de asOf.",
      "estagio": {
        "$match": {
          "dataLocal": {
            "$gte": {
              "$date": "2026-04-19T03:00:00Z"
            },
            "$lt": {
              "$date": "2026-10-16T03:00:00Z"
            }
          }
        }
      }
    },
    {
      "comentario": "Chave sem data: 'toda sexta à noite' = { dow: 6, turno: 'N' } soma todas as sextas da janela. Soma de somas e de contagens (Computed Pattern).",
      "estagio": {
        "$group": {
          "_id": {
            "origem": "$origem",
            "destino": "$destino",
            "tipoVeiculo": "$tipoVeiculo",
            "dow": "$dow",
            "turno": "$turno"
          },
          "somaMin": {
            "$sum": "$somaMin"
          },
          "somaKm": {
            "$sum": "$somaKm"
          },
          "n": {
            "$sum": "$n"
          }
        }
      }
    },
    {
      "comentario": "Média = soma / contagem, calculada uma vez aqui e não na consulta (somas arredondadas a 6 casas, como na camada 1). Grava janela, asOf e versão da config.",
      "estagio": {
        "$project": {
          "_id": 0,
          "origem": "$_id.origem",
          "destino": "$_id.destino",
          "tipoVeiculo": "$_id.tipoVeiculo",
          "dow": "$_id.dow",
          "turno": "$_id.turno",
          "somaMin": {
            "$round": [
              "$somaMin",
              6
            ]
          },
          "somaKm": {
            "$round": [
              "$somaKm",
              6
            ]
          },
          "n": 1,
          "mediaMin": {
            "$divide": [
              {
                "$round": [
                  "$somaMin",
                  6
                ]
              },
              "$n"
            ]
          },
          "mediaKm": {
            "$divide": [
              {
                "$round": [
                  "$somaKm",
                  6
                ]
              },
              "$n"
            ]
          },
          "janelaInicio": {
            "$literal": {
              "$date": "2026-04-19T03:00:00Z"
            }
          },
          "janelaFim": {
            "$literal": {
              "$date": "2026-10-16T03:00:00Z"
            }
          },
          "asOf": {
            "$literal": "2026-10-16"
          },
          "configVersao": {
            "$literal": 1
          },
          "runId": {
            "$literal": "<runId>"
          },
          "atualizadoEm": "$$NOW"
        }
      }
    },
    {
      "comentario": "merge_runid: upsert pela chave única do agregado (replace = idempotente). Chaves que saíram da janela são apagadas depois por runId ≠ atual.",
      "estagio": {
        "$merge": {
          "into": "trecho_media_historica",
          "on": [
            "origem",
            "destino",
            "tipoVeiculo",
            "dow",
            "turno"
          ],
          "whenMatched": "replace",
          "whenNotMatched": "insert"
        }
      }
    }
  ],
  "pipeline": [
    {
      "$match": {
        "dataLocal": {
          "$gte": {
            "$date": "2026-04-19T03:00:00Z"
          },
          "$lt": {
            "$date": "2026-10-16T03:00:00Z"
          }
        }
      }
    },
    {
      "$group": {
        "_id": {
          "origem": "$origem",
          "destino": "$destino",
          "tipoVeiculo": "$tipoVeiculo",
          "dow": "$dow",
          "turno": "$turno"
        },
        "somaMin": {
          "$sum": "$somaMin"
        },
        "somaKm": {
          "$sum": "$somaKm"
        },
        "n": {
          "$sum": "$n"
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "origem": "$_id.origem",
        "destino": "$_id.destino",
        "tipoVeiculo": "$_id.tipoVeiculo",
        "dow": "$_id.dow",
        "turno": "$_id.turno",
        "somaMin": {
          "$round": [
            "$somaMin",
            6
          ]
        },
        "somaKm": {
          "$round": [
            "$somaKm",
            6
          ]
        },
        "n": 1,
        "mediaMin": {
          "$divide": [
            {
              "$round": [
                "$somaMin",
                6
              ]
            },
            "$n"
          ]
        },
        "mediaKm": {
          "$divide": [
            {
              "$round": [
                "$somaKm",
                6
              ]
            },
            "$n"
          ]
        },
        "janelaInicio": {
          "$literal": {
            "$date": "2026-04-19T03:00:00Z"
          }
        },
        "janelaFim": {
          "$literal": {
            "$date": "2026-10-16T03:00:00Z"
          }
        },
        "asOf": {
          "$literal": "2026-10-16"
        },
        "configVersao": {
          "$literal": 1
        },
        "runId": {
          "$literal": "<runId>"
        },
        "atualizadoEm": "$$NOW"
      }
    },
    {
      "$merge": {
        "into": "trecho_media_historica",
        "on": [
          "origem",
          "destino",
          "tipoVeiculo",
          "dow",
          "turno"
        ],
        "whenMatched": "replace",
        "whenNotMatched": "insert"
      }
    }
  ]
}