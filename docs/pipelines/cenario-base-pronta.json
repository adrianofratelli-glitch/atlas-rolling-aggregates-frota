{
  "descricao": "Cenário na janela padrão: soma os documentos prontos do job (seg–sex, 6h–12h).",
  "colecao": "trecho_media_dow_hora",
  "dataRef": "2026-10-22",
  "estagios": [
    {
      "comentario": "Pega na base pronta só a rota e o tipo de veículo pedidos, nos dias da semana e nas horas escolhidos.",
      "estagio": {
        "$match": {
          "origem": "BASE-001",
          "destino": "POSTO-11",
          "tipoVeiculo": "CARRETA",
          "dow": {
            "$in": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "hora": {
            "$in": [
              6,
              7,
              8,
              9,
              10,
              11
            ]
          }
        }
      }
    },
    {
      "comentario": "Soma as contagens e as somas guardadas pelo job e conta quantos documentos prontos foram somados.",
      "estagio": {
        "$group": {
          "_id": null,
          "n": {
            "$sum": "$n"
          },
          "somaMin": {
            "$sum": "$somaMin"
          },
          "somaQuadMin": {
            "$sum": "$somaQuadMin"
          },
          "somaKm": {
            "$sum": "$somaKm"
          },
          "docs": {
            "$sum": 1
          }
        }
      }
    },
    {
      "comentario": "Calcula a estimativa: média do tempo (soma ÷ quantidade), desvio padrão (raiz da média dos quadrados menos o quadrado da média) e média de km.",
      "estagio": {
        "$project": {
          "_id": 0,
          "n": 1,
          "docs": 1,
          "somaMin": 1,
          "somaKm": 1,
          "mediaMin": {
            "$divide": [
              "$somaMin",
              "$n"
            ]
          },
          "desvioMin": {
            "$sqrt": {
              "$max": [
                0,
                {
                  "$subtract": [
                    {
                      "$divide": [
                        "$somaQuadMin",
                        "$n"
                      ]
                    },
                    {
                      "$pow": [
                        {
                          "$divide": [
                            "$somaMin",
                            "$n"
                          ]
                        },
                        2
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "mediaKm": {
            "$divide": [
              "$somaKm",
              "$n"
            ]
          }
        }
      }
    }
  ],
  "pipeline": [
    {
      "$match": {
        "origem": "BASE-001",
        "destino": "POSTO-11",
        "tipoVeiculo": "CARRETA",
        "dow": {
          "$in": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "hora": {
          "$in": [
            6,
            7,
            8,
            9,
            10,
            11
          ]
        }
      }
    },
    {
      "$group": {
        "_id": null,
        "n": {
          "$sum": "$n"
        },
        "somaMin": {
          "$sum": "$somaMin"
        },
        "somaQuadMin": {
          "$sum": "$somaQuadMin"
        },
        "somaKm": {
          "$sum": "$somaKm"
        },
        "docs": {
          "$sum": 1
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "n": 1,
        "docs": 1,
        "somaMin": 1,
        "somaKm": 1,
        "mediaMin": {
          "$divide": [
            "$somaMin",
            "$n"
          ]
        },
        "desvioMin": {
          "$sqrt": {
            "$max": [
              0,
              {
                "$subtract": [
                  {
                    "$divide": [
                      "$somaQuadMin",
                      "$n"
                    ]
                  },
                  {
                    "$pow": [
                      {
                        "$divide": [
                          "$somaMin",
                          "$n"
                        ]
                      },
                      2
                    ]
                  }
                ]
              }
            ]
          }
        },
        "mediaKm": {
          "$divide": [
            "$somaKm",
            "$n"
          ]
        }
      }
    }
  ]
}
